# =============================================================================
# .env.example — variables d'environnement de l'agent documentaire
# =============================================================================
# Copier en `.env` puis adapter à la machine. `.env` n'est jamais commité
# (voir .gitignore). Ce fichier est la SEULE source pour les secrets, les
# chemins et le choix des modèles ; le réglage technique (chunking, seuils,
# Qdrant, agent) vit dans config/default.yaml, la taxonomie métier dans
# config/schemas/<profil>.yaml.
#
# Toute clé absente ci-dessous prend la valeur par défaut de
# `src/config.py::Settings`. Toute clé inconnue est ignorée silencieusement
# (pydantic `extra="ignore"`) — ne pas s'y fier pour activer une option.
# =============================================================================


# ---- LLM : Ollama uniquement -------------------------------------------------
# Le projet est câblé exclusivement sur Ollama (src/llm/factory.py). Aucun
# fournisseur cloud n'est supporté. Modèle de référence gelé : qwen3:8b.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_NUM_CTX=16384


# ---- Embeddings et reranking (locaux) -------------------------------------- -
# BGE-M3 produit dense (1024d) + sparse en un passage ; reranking BGE-v2-m3.
# EMBEDDING_DEVICE : "cuda" si un GPU est disponible, sinon "cpu" (résultats
# numériquement équivalents, seulement plus lents).
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true


# ---- Qdrant : environnement et connexion ----------------------------------- -
# QDRANT_MODE=local  -> base fichier embarquée sous QDRANT_PATH
# QDRANT_MODE=server -> Qdrant distant sur QDRANT_URL (+ QDRANT_API_KEY)
# QDRANT_PATH : chemin RELATIF au projet (recommandé) ou ABSOLU valide.
#   ⚠ Ne PAS mettre "/data/..." : un chemin absolu vers un dossier système
#   non inscriptible fait échouer `Settings.creer_dossiers()` au démarrage.
# Le nom de la collection n'est PAS lu ici : config/default.yaml -> qdrant.nom_collection.
QDRANT_MODE=local
QDRANT_PATH=data/vectordb
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=


# ---- OCR (Tesseract) ------------------------------------------------------- -
# TESSERACT_CMD : requis seulement si le binaire n'est pas sur le PATH
#   (typiquement sous Windows : C:\Program Files\Tesseract-OCR\tesseract.exe).
OCR_ENABLED=true
OCR_LANGUAGES=fra+ara+eng
TESSERACT_CMD=


# ---- Chemins -------------------------------------------------------------- - -
# Relatifs au projet, ou absolus. Créés au démarrage s'ils n'existent pas.
DOCUMENTS_DIR=data/documents
LOGS_DIR=data/logs


# ---- Profil technique actif (config/schemas/<nom>.yaml) ------------------- - -
# Pilote taxonomie, métadonnées et schéma d'extraction (ingestion + retrieval).
ACTIVE_PROFILE=generic


# ---- Profil de domaine (profiles/domains/<nom>.yaml) --------------------- - -
# Vocabulaire métier injecté dans les prompts de génération. Facultatif :
# laisser vide pour un fonctionnement sans contexte métier.
DOMAIN_PROFILES_DIR=profiles/domains
ACTIVE_DOMAIN_PROFILE=
DOMAIN_PROFILE_OUTPUT_LANGUAGE=fr


# ---- Journalisation ----------------------------------------------------- - - -
LOG_LEVEL=INFO
