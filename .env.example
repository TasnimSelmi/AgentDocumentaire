# ---- LLM ----
LLM_PROVIDER=openai
LLM_API_KEY=sk-xxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# ---- Embeddings ----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true

# ---- Qdrant ----
QDRANT_MODE=local
QDRANT_PATH=data/vectordb
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Le nom de la collection n'est PAS lu ici : la source de vérité est
# config/default.yaml -> qdrant.nom_collection.

# ---- OCR ----
OCR_ENABLED=true
OCR_LANGUAGES=fra+ara+eng
TESSERACT_CMD=

# ---- Chemins ----
DOCUMENTS_DIR=data/documents
VECTORDB_DIR=data/vectordb
LOGS_DIR=data/logs

# ---- Profil actif ----
ACTIVE_PROFILE=generic

LOG_LEVEL=INFO